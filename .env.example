# ── API (apps/api) ─────────────────────────────
# Neon Free Postgres (https://neon.tech). Nunca commitees el valor real.
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/reformapp?sslmode=require
JWT_SECRET=cambia-esto-min-32-chars-solo-servidor
# R2 (Cloudflare) — presigned URLs, egress 0€
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=reformapp-dev
R2_PUBLIC_URL=https://pub-xxx.r2.dev
PORT=3000

# ── Mobile (apps/mobile, prefijo EXPO_PUBLIC_!) ─
# Dev LAN: usa `adb reverse` o túnel. Ejemplo: http://10.0.0.5:3000
EXPO_PUBLIC_API_URL=http://10.0.0.5:3000
EXPO_PUBLIC_ENV=development
